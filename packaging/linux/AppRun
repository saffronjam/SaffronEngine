#!/usr/bin/env bash
# AppImage entrypoint. Wires the bundled layout to the three runtime knobs the engine reads:
# CEF resolves libcef.so + its resource packs beside the shell binary (usr/bin), the host is
# spawned from SAFFRON_ANIMA_BIN, and the engine data roots come from SAFFRON_ASSET_DIR
# (models/fonts/icons under <dir>/assets) and SAFFRON_SHADER_DIR (compiled SPIR-V).
set -euo pipefail
HERE="$(dirname "$(readlink -f "${0}")")"

export LD_LIBRARY_PATH="${HERE}/usr/bin:${LD_LIBRARY_PATH:-}"
export SAFFRON_ANIMA_BIN="${HERE}/usr/bin/saffron-host"
export SAFFRON_ASSET_DIR="${HERE}/usr/share/saffron-anima"
export SAFFRON_SHADER_DIR="${HERE}/usr/share/saffron-anima/assets/shaders"

# The bundled React UI lives at usr/share/saffron-anima/ui. Loading it needs the app:// prod
# scheme, which is not wired yet; until it lands the shell shows a placeholder. Point
# SAFFRON_DEV_URL at a running Vite server to exercise the real UI against this bundle.
exec "${HERE}/usr/bin/saffron-editor-shell" "$@"
