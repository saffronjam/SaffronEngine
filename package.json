{
  "name": "saffron-anima",
  "private": true,
  "type": "module",
  "workspaces": ["editor", "packager", "tests/e2e", "tools"],
  "scripts": {
    "format": "oxfmt --write '**/*.ts' '**/*.tsx'",
    "format:check": "oxfmt --check '**/*.ts' '**/*.tsx'",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p editor"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "typescript": "^5.9.0"
  }
}
